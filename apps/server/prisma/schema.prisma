generator client {
    provider = "prisma-client"
    output   = "../src/generated"
}

datasource db {
    provider = "postgresql"
}

model User {
    id             String         @id @default(cuid())
    emailHash      String         @unique
    encryptedEmail String
    passwordHash   String
    displayName    String
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt
    refreshTokens  RefreshToken[]
    assignedTasks  Task[]         @relation("AssignedTo")
    createdTasks   Task[]         @relation("CreatedBy")
    teamMembers    TeamMember[]
}

model RefreshToken {
    id        String   @id @default(cuid())
    userId    String
    token     String
    prefix    String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId], name: "ix_refresh_token_user_id")
    @@index([prefix], name: "ix_refresh_token_prefix")
}

model Team {
    id         String   @id @default(cuid())
    name       String
    inviteCode String   @unique @default(cuid())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    members TeamMember[]
    tasks   Task[]

    @@index([inviteCode], name: "ix_team_invite_code")
}

model TeamMember {
    id       String   @id @default(cuid())
    userId   String
    teamId   String
    role     Role     @default(MEMBER)
    joinedAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

    @@unique([userId, teamId], name: "uq_team_member_user_team")
    @@index([teamId], name: "ix_team_member_team_id")
    @@index([userId], name: "ix_team_member_user_id")
}

model Task {
    id            String    @id @default(cuid())
    teamId        String
    title         String
    description   String?
    completed     Boolean   @default(false)
    assignedToId  String?
    createdById   String
    calendarStart DateTime?
    calendarEnd   DateTime?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    team       Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
    assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
    createdBy  User  @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

    @@index([teamId], name: "ix_task_team_id")
    @@index([assignedToId], name: "ix_task_assigned_to_id")
    @@index([createdById], name: "ix_task_created_by_id")
    @@index([teamId, completed], name: "ix_task_team_completed")
    @@index([assignedToId, completed], name: "ix_task_assigned_completed")
    @@index([teamId, calendarStart, calendarEnd], name: "ix_task_calendar_range")
    @@index([teamId, calendarEnd], name: "ix_task_team_deadline")
    @@index([teamId, createdAt], name: "ix_task_team_created")
}

enum Role {
    ADMIN
    MEMBER
}
