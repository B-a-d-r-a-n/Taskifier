{
    "extends": "../../packages/config/tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "../../",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "target": "ES2022",
        "types": ["node", "jest"],
        "paths": {
            "@taskifier/env/server": ["../../packages/env/src/server.ts"],
            "@taskifier/types": ["../../packages/types/src/index.ts"],
            "@taskifier/utils": ["../../packages/utils/src/index.ts"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
